# Local env files — never commit real values
.env
.env.*
!.env.example

# Dependencies / build output
node_modules
dist

# Generated local email template previews (regenerate with bun run email:preview)
email-preview

# Secrets, keys and credentials (defensive)
*.pem
*.key
*.p12
*.pfx
*.crt
service-account*.json
id_rsa*
credentials.json
*.json.enc

# Platform sandbox build artifacts
isolate

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Editor / OS
.DS_Store
.idea
.vscode
*.swp
.vercel
.env*
# repo-root env.local (no leading dot) is NOT covered by .env* —
# explicitly ignore it; it carried a leaked token once and must never return
env.local
